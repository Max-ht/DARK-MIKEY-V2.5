# Copie ce fichier en ".env" et remplis les valeurs. Ne publie jamais ".env".

# --- Identité ---
BOT_NAME=DARK-MIKEY
OWNER_NUMBER=509XXXXXXXX        # ton numéro avec l'indicatif, sans + ni espaces (plusieurs: sépare par des virgules)
OWNER_NAME=Mikey
PREFIX=/

# --- Session WhatsApp ---
# Laisse vide pour scanner un QR au premier lancement, ou colle ta session (DARK-MIKEY!... ou KnightBot!...)
SESSION_ID=

# --- Clés d'API ---
OPENWEATHER_API_KEY=
PRINCETECH_API_KEY=

# --- Mise à jour (.update) ---
# URL du ZIP de TON dépôt, ex: https://github.com/TON-COMPTE/DARK-MIKEY/archive/refs/heads/main.zip
UPDATE_ZIP_URL=
# Optionnel mais recommandé : empreinte SHA-256 attendue du ZIP
UPDATE_ZIP_SHA256=

# --- Liens (optionnels) ---
GITHUB_REPO=                    # format: ton-compte/DARK-MIKEY
GITHUB_URL=
YOUTUBE_URL=
CHANNEL_URL=
NEWSLETTER_JID=

# --- Divers ---
TIMEZONE=America/Port-au-Prince   # Haïti (UTC-4 en heure d'été, UTC-5 en hiver)

# --- Telegram (cloud secondaire auto-vv) ---
# Voir tuto dans le README pour créer le bot et le canal
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
