{
  "name": "DARK-MIKEY",
  "description": "WhatsApp MD bot (Baileys)",
  "repository": "",
  "keywords": [
    "whatsapp",
    "baileys",
    "bot",
    "node"
  ],
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "Session string (ex: DARK-MIKEY!<base64_compressed_data>)",
      "required": false,
      "value": ""
    },
    "OWNER_NUMBER": {
      "description": "Ton numéro avec indicatif, sans + ni espaces",
      "required": true,
      "value": ""
    },
    "BOT_NAME": {
      "description": "Nom du bot",
      "required": false,
      "value": "DARK-MIKEY"
    },
    "PREFIX": {
      "description": "Préfixe des commandes",
      "required": false,
      "value": ","
    }
  }
}
